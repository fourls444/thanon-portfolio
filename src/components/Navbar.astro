---
const links = [
  { label: "About", href: "#about" },
  { label: "Skills", href: "#skills" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
] as const;
---

<header class="site-header" data-header>
  <nav class="navbar shell" aria-label="Primary navigation">
    <a class="wordmark" href="#top" aria-label="Portfolio back to top">
      Portfolio
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-menu"
      aria-label="Open navigation menu"
      data-open-label="Open navigation menu"
      data-close-label="Close navigation menu"
      data-menu-toggle
    >
      <span></span><span></span>
    </button>

    <div class="nav-links" id="primary-menu" data-menu>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  const setMenuLabelState = (state: "open" | "close") => {
    if (!toggle) return;
    const label = state === "open" ? toggle.dataset.openLabel : toggle.dataset.closeLabel;
    toggle.setAttribute("aria-label", label ?? "Open navigation menu");
  };

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    setMenuLabelState("open");
    menu?.classList.remove("is-open");
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    setMenuLabelState(isOpen ? "open" : "close");
    menu?.classList.toggle("is-open", !isOpen);
  });

  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || toggle?.getAttribute("aria-expanded") !== "true") return;
    closeMenu();
    toggle?.focus();
  });

  const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 20);
  let scrollFrame = 0;
  const requestHeaderUpdate = () => {
    if (scrollFrame) return;
    scrollFrame = window.requestAnimationFrame(() => {
      updateHeader();
      scrollFrame = 0;
    });
  };
  updateHeader();
  window.addEventListener("scroll", requestHeaderUpdate, { passive: true });
</script>
