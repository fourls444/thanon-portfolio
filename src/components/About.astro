---
import { getAge, profile } from "../data/profile";

const age = getAge(profile.dateOfBirth);
const interestedPositions = [
  "Full Stack Developer",
  "Backend Developer",
  "Data Analyst",
  "Mobile Developer",
];
const imageSrc = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}icons/me.jpg`;
---

<section class="section about-section" id="about" aria-labelledby="about-title" data-reveal-group>
  <div class="shell">
    <div class="section-heading about-heading reveal" data-motion="fade-up">
      <span class="section-index">01 / About Me</span>
      <h1 id="about-title">Get to know me.</h1>
    </div>

    <p class="availability-badge reveal" data-motion="fade-up" data-motion-delay="0.08"><span aria-hidden="true"></span>Open to opportunities</p>

    <div class="about-profile">
      <figure class="about-photo reveal" data-photo-slot data-motion="from-left-scale" data-motion-delay="0.12">
        <div class="about-photo-frame">
          <img
            src={imageSrc}
            alt="Thanon Macharoen"
            width="449"
            height="591"
            sizes="(max-width: 720px) 360px, 36vw"
            loading="eager"
            decoding="async"
          />
        </div>
      </figure>

      <div class="about-details">
        <div class="profile-groups">
          <section class="profile-group reveal" data-motion="from-right" data-motion-delay="0.16">
            <header class="profile-group-heading">
              <span aria-hidden="true">01</span>
              <h2>Personal</h2>
            </header>
            <dl class="profile-group-facts">
              <div>
                <dt>English Name</dt>
                <dd>{profile.name}</dd>
              </div>
              <div>
                <dt>Thai Name</dt>
                <dd>{profile.thaiName}</dd>
              </div>
              <div>
                <dt>Date of Birth</dt>
                <dd>6 March 2004</dd>
              </div>
              <div>
                <dt>Age</dt>
                <dd>{age} years old</dd>
              </div>
            </dl>
          </section>

          <section class="profile-group reveal" data-motion="from-right" data-motion-delay="0.28">
            <header class="profile-group-heading">
              <span aria-hidden="true">02</span>
              <h2>Career</h2>
            </header>
            <dl class="profile-group-facts profile-group-facts--single">
              <div>
                <dt>Interested Positions</dt>
                <dd>
                  <ul class="interest-list">
                    {interestedPositions.map((position) => <li>{position}</li>)}
                  </ul>
                </dd>
              </div>
            </dl>
          </section>

          <section class="profile-group reveal" data-motion="from-right" data-motion-delay="0.4">
            <header class="profile-group-heading">
              <span aria-hidden="true">03</span>
              <h2>Education</h2>
            </header>
            <dl class="profile-group-facts">
              <div>
                <dt>University</dt>
                <dd>Rangsit University<br />Computer Science<br />GPAX 3.78</dd>
              </div>
            </dl>
          </section>
        </div>
      </div>
    </div>
  </div>
</section>
