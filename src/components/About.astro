---
import { getAge, profile } from "../data/profile";

const age = getAge(profile.dateOfBirth);
const interestedPositions = [
  "Full-Stack Developer",
  "Backend Developer",
  "Mobile Developer",
  "Data Analyst",
];
const imageSrc = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}icons/me.jpg`;
---

<section class="section about-section" id="about" aria-labelledby="about-title" data-reveal-group>
  <div class="shell">
    <div class="section-heading about-heading reveal" data-motion="fade-up">
      <span class="section-index">01 / About Me</span>
      <h1 id="about-title">Thanon Macharoen</h1>
      <div class="about-introduction">
        <p>Recent Computer Science graduate from Rangsit University with a GPA of <span class="about-gpa">3.78.</span></p>
        <p>During my internship, I helped develop PharmacyOne's website, CMS, <span class="about-intro-line">and backend API with Next.js, React, TypeScript, Node.js, and PostgreSQL.</span></p>
        <p>My other projects include e-commerce, a LINE OA chatbot, and Flutter/Dart apps. <span class="about-intro-line">I also have a foundation in Python for computer vision and data analysis, and in Java OOP.</span></p>
      </div>
    </div>

    <p class="availability-badge reveal" data-motion="fade-up" data-motion-delay="0.08"><span aria-hidden="true"></span>Open to opportunities</p>

    <div class="about-profile">
      <figure class="about-photo reveal" data-photo-slot data-motion="from-left-scale" data-motion-delay="0.12">
        <div class="about-photo-frame">
          <img
            src={imageSrc}
            alt="Thanon Macharoen"
            width="449"
            height="591"
            sizes="(max-width: 720px) 360px, 36vw"
            loading="eager"
            decoding="async"
          />
        </div>
      </figure>

      <div class="about-details">
        <div class="profile-groups">
          <section class="profile-group reveal" data-motion="from-right" data-motion-delay="0.16">
            <header class="profile-group-heading">
              <span aria-hidden="true">01</span>
              <h2>Personal</h2>
            </header>
            <dl class="profile-group-facts">
              <div>
                <dt>English Name</dt>
                <dd>{profile.name}</dd>
              </div>
              <div>
                <dt>Thai Name</dt>
                <dd>{profile.thaiName}</dd>
              </div>
              <div>
                <dt>Date of Birth</dt>
                <dd>6 March 2004</dd>
              </div>
              <div>
                <dt>Age</dt>
                <dd><span data-profile-age data-date-of-birth={profile.dateOfBirth}>{age}</span> years old</dd>
              </div>
            </dl>
          </section>

          <section class="profile-group reveal" data-motion="from-right" data-motion-delay="0.28">
            <header class="profile-group-heading">
              <span aria-hidden="true">02</span>
              <h2>Career</h2>
            </header>
            <dl class="profile-group-facts profile-group-facts--single">
              <div>
                <dt>Interested Positions</dt>
                <dd>
                  <ul class="interest-list">
                    {interestedPositions.map((position) => <li>{position}</li>)}
                  </ul>
                </dd>
              </div>
            </dl>
          </section>

          <section class="profile-group reveal" data-motion="from-right" data-motion-delay="0.4">
            <header class="profile-group-heading">
              <span aria-hidden="true">03</span>
              <h2>Education</h2>
            </header>
            <dl class="profile-group-facts">
              <div>
                <dt>Education</dt>
                <dd>{profile.university}<br />{profile.degree}<br />GPA {profile.gpa}</dd>
              </div>
            </dl>
          </section>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { getAge } from "../data/profile";

  const updateAge = () => {
    document.querySelectorAll<HTMLElement>("[data-profile-age]").forEach((element) => {
      if (element.dataset.dateOfBirth) element.textContent = String(getAge(element.dataset.dateOfBirth));
    });
  };
  updateAge();
  window.addEventListener("pageshow", updateAge);
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) updateAge();
  });
</script>
