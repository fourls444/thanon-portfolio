---
import { profile } from "../data/profile";

const contactLinks = [
  { label: "GitHub", href: profile.github, preview: "github.com/fourls444", action: "Open profile", icon: "github", external: true },
  { label: "LinkedIn", href: profile.linkedin, preview: "linkedin.com/in/thanon-macharoen", action: "Open profile", icon: "linkedin", external: true },
  { label: "Email", href: `mailto:${profile.email}`, preview: profile.email, action: "Send email", icon: "email", external: false, copyValue: profile.email },
  { label: "Phone", href: `tel:${profile.phone}`, preview: profile.phone, action: "Call now", icon: "phone", external: false, copyValue: profile.phone },
] as const;
---

<section class="section contact-section" id="contact" aria-labelledby="contact-title" data-reveal-group>
  <div class="shell contact-card">
    <span class="section-index reveal" data-motion="fade-up">04 / Contact</span>
    <div class="contact-minimal-row">
      <div class="contact-actions">
        <h2 id="contact-title" class="reveal" data-motion="scale-up" data-motion-delay="0.08">Let's connect.</h2>
      </div>
      <div class="contact-links" aria-label="Contact links">
          {contactLinks.map((link, index) => (
            <div class:list={["contact-link-wrap", "copyValue" in link && "contact-link-wrap--with-copy"]}>
              <a
                class="contact-icon-link reveal"
                data-motion="pop"
                data-motion-delay={String(0.16 + index * 0.06)}
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
                aria-label={link.external ? `${link.label}, opens in a new tab` : link.label}
                aria-describedby={`contact-preview-${link.icon}`}
              >
              {link.icon === "github" && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-3 18.51c.48.09.66-.21.66-.47v-1.67c-2.7.59-3.27-1.3-3.27-1.3-.43-1.1-1.05-1.4-1.05-1.4-.86-.59.07-.58.07-.58.95.07 1.45.98 1.45.98.85 1.45 2.22 1.03 2.76.79.09-.61.33-1.03.6-1.27-2.16-.25-4.43-1.08-4.43-4.8 0-1.06.38-1.92 1-2.6-.1-.25-.43-1.24.1-2.57 0 0 .81-.26 2.63.99A9.2 9.2 0 0 1 12 6.8c.82 0 1.65.11 2.42.32 1.82-1.25 2.63-.99 2.63-.99.53 1.33.2 2.32.1 2.57.62.68 1 1.54 1 2.6 0 3.73-2.27 4.55-4.44 4.8.35.3.66.88.66 1.78v2.66c0 .26.18.57.67.47A9.5 9.5 0 0 0 12 2.5Z" /></svg>
              )}
              {link.icon === "linkedin" && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 7.1a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4ZM3.7 20.3h3V9h-3v11.3ZM9 9v11.3h3v-6.28c0-1.65.31-3.25 2.36-3.25 2.02 0 2.05 1.89 2.05 3.36v6.17h3v-6.83c0-3.35-.72-5.92-4.62-5.92-1.88 0-3.14 1.03-3.66 2.01h-.04V9H9Z" /></svg>
              )}
              {link.icon === "email" && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.5h17v13h-17v-13Zm.7 1 7.8 6 7.8-6M4 17.5l5.1-4M20 17.5l-5.1-4" /></svg>
              )}
              {link.icon === "phone" && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.1 3.7 9.9 3l1.5 4-1.8 1.45a13.6 13.6 0 0 0 5.95 5.95L17 12.6l4 1.5-.7 2.8a2.4 2.4 0 0 1-2.6 1.8C10.6 17.9 6.1 13.4 5.3 6.3a2.4 2.4 0 0 1 1.8-2.6Z" /></svg>
              )}
                <span>{link.label}</span>
              </a>

              {"copyValue" in link && (
                <button
                  type="button"
                  class="contact-copy-button"
                  data-copy-button
                  data-copy-value={link.copyValue}
                  aria-label={`Copy ${link.label} to clipboard`}
                  title={`Copy ${link.label}`}
                >
                  <svg class="contact-copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <svg class="contact-check-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span class="contact-copied-badge" aria-hidden="true">Copied!</span>
                </button>
              )}

              <span class="contact-preview" id={`contact-preview-${link.icon}`} role="tooltip">
                <span class="contact-preview-label">{"copyValue" in link ? `${link.action} · Click 📋 to copy` : link.action}</span>
                <span class="contact-preview-title">{link.label}</span>
                <span class="contact-preview-url">{link.preview}</span>
                <span class="contact-preview-arrow" aria-hidden="true">↗</span>
              </span>
            </div>
          ))}
      </div>
    </div>
  </div>
  <div class="shell contact-bottom">
    <a class="back-to-top reveal" data-motion="fade-up" data-motion-delay="0.42" href="#top">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-button]").forEach((button) => {
    button.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const textToCopy = button.dataset.copyValue;
      if (!textToCopy) return;

      let success = false;
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(textToCopy);
          success = true;
        } catch {
          success = false;
        }
      }

      if (!success) {
        const textarea = document.createElement("textarea");
        textarea.value = textToCopy;
        textarea.style.position = "fixed";
        textarea.style.left = "-9999px";
        document.body.appendChild(textarea);
        textarea.select();
        try {
          success = Boolean((document as any).execCommand?.("copy"));
        } catch {
          success = false;
        }
        textarea.remove();
      }

      if (success) {
        button.classList.add("is-copied");
        const badge = button.querySelector<HTMLElement>(".contact-copied-badge");
        if (badge) badge.textContent = "Copied!";

        setTimeout(() => {
          button.classList.remove("is-copied");
        }, 2200);
      }
    });
  });
</script>
