---
import { profile } from "../data/profile";
---

<section class="section contact-section" id="contact" aria-labelledby="contact-title">
  <div class="shell contact-card reveal">
    <span class="section-index">04 / Contact</span>
    <div class="contact-grid">
      <div>
        <p class="contact-eyebrow">Have an idea or opportunity?</p>
        <h2 id="contact-title">Let's build something<br /><em>meaningful.</em></h2>
      </div>
      <div class="contact-action">
        <p>
          I'm always open to learning, collaborating, and talking about useful
          digital products.
        </p>
        <a class="contact-link" href={`mailto:${profile.email}`}>
          Get in touch <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </div>
  </div>
</section>
