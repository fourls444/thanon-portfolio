---
import { techGroups } from "../data/tech";
---

<section class="section tech-section" id="skills" aria-labelledby="skills-title">
  <div class="shell">
    <div class="section-heading reveal">
      <span class="section-index">02 / Tech Stack</span>
      <h2 id="skills-title">Tools I build with.</h2>
    </div>

    <div class="tech-grid">
      {techGroups.map((group) => (
        <article class="tech-card reveal">
          <header class="tech-card-heading">
            <h3>{group.title}</h3>
            <span class="tech-count" aria-hidden="true">{String(group.items.length).padStart(2, "0")}</span>
          </header>
          <ul>
            {group.items.map((item) => {
              const iconSrc = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${item.icon.replace(/^\//, "")}`;

              return (
                <li class:list={["tech-item", { "tech-item--light-icon-surface": item.lightSurface }]}>
                  <img class="tech-icon" src={iconSrc} alt="" width="40" height="40" loading="lazy" decoding="async" />
                  <span>{item.name}</span>
                </li>
              );
            })}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
