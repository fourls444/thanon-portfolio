---
import { content } from "../data/content";
---

<section class="section education-section" id="education" aria-labelledby="education-title">
  <div class="shell">
    <div class="section-heading reveal">
      <span class="section-index" data-lang-content="th">{content.th.education.label}</span>
      <span class="section-index" data-lang-content="en">{content.en.education.label}</span>
      <h2 id="education-title">
        <span data-lang-content="th">{content.th.education.title}</span>
        <span data-lang-content="en">{content.en.education.title}</span>
      </h2>
    </div>

    <div class="timeline reveal reveal-delay">
      <article class="timeline-item timeline-featured">
        <div class="timeline-meta">
          <span>
            <span class="lang-inline" data-lang-content="th">{content.th.education.education}</span>
            <span class="lang-inline" data-lang-content="en">{content.en.education.education}</span>
          </span>
          <span>
            <span class="lang-inline" data-lang-content="th">{content.th.education.present}</span>
            <span class="lang-inline" data-lang-content="en">{content.en.education.present}</span>
          </span>
        </div>
        <div class="timeline-body">
          <h3>Rangsit University</h3>
          <p>
            <span class="lang-inline" data-lang-content="th">{content.th.education.degree}</span>
            <span class="lang-inline" data-lang-content="en">{content.en.education.degree}</span>
          </p>
        </div>
      </article>

      <article class="timeline-item">
        <div class="timeline-meta">
          <span>
            <span class="lang-inline" data-lang-content="th">{content.th.education.achievement}</span>
            <span class="lang-inline" data-lang-content="en">{content.en.education.achievement}</span>
          </span>
          <span>
            <span class="lang-inline" data-lang-content="th">{content.th.education.activity}</span>
            <span class="lang-inline" data-lang-content="en">{content.en.education.activity}</span>
          </span>
        </div>
        <div class="timeline-body">
          <h3>
            <span data-lang-content="th">{content.th.education.runnerUp}</span>
            <span data-lang-content="en">{content.en.education.runnerUp}</span>
          </h3>
          <p>Thai AI Ethics Awareness</p>
        </div>
      </article>

      <article class="timeline-item">
        <div class="timeline-meta">
          <span>
            <span class="lang-inline" data-lang-content="th">{content.th.education.workshop}</span>
            <span class="lang-inline" data-lang-content="en">{content.en.education.workshop}</span>
          </span>
          <span>
            <span class="lang-inline" data-lang-content="th">{content.th.education.activity}</span>
            <span class="lang-inline" data-lang-content="en">{content.en.education.activity}</span>
          </span>
        </div>
        <div class="timeline-body">
          <h3>LINE Dev Camp</h3>
          <p>
            <span class="lang-inline" data-lang-content="th">{content.th.education.participant}</span>
            <span class="lang-inline" data-lang-content="en">{content.en.education.participant}</span>
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
