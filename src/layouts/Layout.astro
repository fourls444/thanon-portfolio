---
import CursorGlow from "../components/CursorGlow.astro";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Portfolio Thanon",
  description = "Portfolio of Thanon, a Computer Science student and software developer focused on modern web experiences.",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const faviconHref = `${baseUrl}favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070b17" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://raw.githubusercontent.com" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <CursorGlow />
    <slot />

    <script>
      import Lenis from "lenis";

      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const reduceMotion = reducedMotionQuery.matches;
      let lenis: Lenis | null = null;

      const syncLenis = () => {
        if (reducedMotionQuery.matches) {
          lenis?.destroy();
          lenis = null;
          return;
        }

        lenis ??= new Lenis({
          autoRaf: true,
          anchors: { offset: -72 },
          duration: 1.05,
          smoothWheel: true,
        });
      };

      syncLenis();
      reducedMotionQuery.addEventListener("change", syncLenis);

      const revealItems = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8%" },
        );
        revealItems.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
